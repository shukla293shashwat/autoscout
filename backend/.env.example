---
# AutoScout configuration example.
# Copy this file to `.env` (never commit your real .env) and fill in values.
---

# LLM provider: "mock" (offline, no key needed) or "openai" (or any OpenAI-compatible API)
LLM_PROVIDER=mock

# Model name used when LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# API key for the chosen provider (leave blank when using the mock provider)
LLM_API_KEY=

# Base URL for an OpenAI-compatible endpoint (override for Azure/OpenRouter/local)
LLM_BASE_URL=https://api.openai.com/v1

# Request timeout in seconds
LLM_TIMEOUT_S=30

# Cache LLM responses (set to false to force fresh calls)
LLM_CACHE_ENABLED=true

# Set to true to bypass the response cache on every call
LLM_NO_CACHE=false

# Offline demo mode: uses the mock provider + cached results
DEMO_MODE=false
